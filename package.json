{
  "name": "aurumdesk",
  "version": "1.0.0",
  "description": "Aurum Pulse: self-hosted XAU/USD terminal with graded trade setups, order flow, COT positioning, liquidity and a paper auto-trader.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "demo": "node server/index.js --demo",
    "test": "node --test",
    "backtest": "node server/backtest.js",
    "build:hosted": "node hosted/build.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "lightweight-charts": "4.2.3"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
