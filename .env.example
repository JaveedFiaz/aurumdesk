# Copy to .env and edit. Environment variables override these.

# Gold price feed: binance (free PAXG gold token, default), oanda (spot XAU/USD,
# same prices as TradingView's OANDA:XAUUSD, free practice-account key),
# twelvedata, or demo (offline synthetic data for both markets).
PROVIDER=binance
PORT=3000

# Binance: data-api.binance.vision is the public market-data mirror.
# BINANCE_BASE=https://data-api.binance.vision
# BINANCE_SYMBOL=PAXGUSDT
# BTC_SYMBOL=BTCUSDT

# OANDA: free practice account at oanda.com, then Manage API Access -> Generate token.
# OANDA_API_KEY=
# OANDA_ENV=practice

# Protects the auto-trader's controls. Set this whenever the site is public.
# ADMIN_TOKEN=

# Set to 1 to stop the auto-trader opening trades within 5 minutes of high-impact news.
# NEWS_PAUSE=0

# Fraction of the backtest history to load (1 = full). Lower it on small servers.
# HISTORY_SCALE=1

# Where the paper account is saved.
# DATA_DIR=data

# On Render the server requests its own public address every 10 minutes so the
# free plan does not put it to sleep. Set to 0 to turn that off.
# KEEP_ALIVE=1
