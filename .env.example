# Copy to .env and edit. Environment variables override these.

# binance (free, PAXG/USDT gold token), oanda (same prices as TradingView's OANDA:XAUUSD,
# free practice-account key), twelvedata (spot XAU/USD, API key) or demo (offline synthetic data)
PROVIDER=binance
PORT=3000

# How often the server polls the live price, in milliseconds.
# Defaults: binance 1000, twelvedata 10000, demo 1000.
# POLL_MS=1000

# Binance: data-api.binance.vision is the public market-data mirror and works in most regions.
# BINANCE_BASE=https://data-api.binance.vision
# BINANCE_SYMBOL=PAXGUSDT

# OANDA: open a free practice account at oanda.com, then Manage API Access -> Generate token.
# OANDA_API_KEY=
# OANDA_ENV=practice          # or live for a live-account token
# OANDA_INSTRUMENT=XAU_USD

# Symbol shown in the TradingView chart view.
# TV_SYMBOL=OANDA:XAUUSD

# Twelve Data: https://twelvedata.com/pricing
# TWELVEDATA_API_KEY=
# TWELVEDATA_SYMBOL=XAU/USD

# Trade finder: how many 15m candles to backtest (70000 is about 2 years, the default).
# BOT_HISTORY=70000

# Order flow (taker volume, big trades, order book) from PAXG on Binance, or none.
# FLOW_PROVIDER=binance

# Protects the auto-trader's controls. Set this whenever the site is public.
# ADMIN_TOKEN=

# Where the paper account is saved.
# DATA_DIR=data
